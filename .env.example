GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
TAVILY_API_KEY=your_tavily_api_key   # optional: web/Reddit search (DuckDuckGo is used when it's missing or out of credits)

# Research agents (Agno). Set AGENTS_ENABLED=0 to use the plain, non-agent checks instead.
AGENTS_ENABLED=1
# One model per agent, in order: reputation, company, funding. Groq's free tier limits tokens per minute
# per model, so spreading agents across models avoids rate limits. The parser turns each agent's answer into JSON.
GROQ_AGENT_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_PARSER_MODEL=openai/gpt-oss-120b

# Login (Supabase Auth). Both values are public by design; leave them empty to run without login locally.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Set to 0 to turn off every online check (domain age, website, search).
LIVE_LOOKUPS=1
